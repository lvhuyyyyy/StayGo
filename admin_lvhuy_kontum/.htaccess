Options -Indexes
ServerSignature Off

# ══════════════════════════════════════════
# 1. CHẶN FILE NHẠY CẢM
# ══════════════════════════════════════════
<FilesMatch "\.(sql|log|env|bak|backup|sh|git|ini|conf|config|htpasswd|DS_Store|txt)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Chặn file ẩn (bắt đầu bằng dấu chấm)
<FilesMatch "^\.">
    Order deny,allow
    Deny from all
</FilesMatch>

# ══════════════════════════════════════════
# 2. SECURITY HEADERS
# ══════════════════════════════════════════
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header unset Server
    Header unset X-Powered-By
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>

# ══════════════════════════════════════════
# 3. CHẶN TẤN CÔNG PHỔ BIẾN
# ══════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chặn SQL Injection — dùng cặp từ khóa, tránh false positive với ?id=
    RewriteCond %{QUERY_STRING} (union(\s|%20|%09)+select) [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{QUERY_STRING} (insert(\s|%20|%09)+into) [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{QUERY_STRING} (drop(\s|%20|%09)+(table|database)) [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{QUERY_STRING} (delete(\s|%20|%09)+from) [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{QUERY_STRING} (update(\s|%20|%09)+\w+(\s|%20|%09)+set) [NC]
    RewriteRule .* - [F,L]

    RewriteCond %{QUERY_STRING} (benchmark\s*\(|load_file\s*\(|unhex\s*\() [NC]
    RewriteRule .* - [F,L]

    # Chặn XSS
    RewriteCond %{QUERY_STRING} (<script|%3Cscript|javascript:|vbscript:) [NC]
    RewriteRule .* - [F,L]

    # Chặn path traversal
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC]
    RewriteRule .* - [F,L]

    # Chặn null byte
    RewriteCond %{QUERY_STRING} (%00|%0d%0a) [NC]
    RewriteRule .* - [F,L]

    # Chặn dấu nháy kết hợp từ khóa SQL
    RewriteCond %{QUERY_STRING} ('(\s|%20)*(or|and|union)(\s|%20)) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ══════════════════════════════════════════
# 4. CHẶN BAD BOTS & USER AGENTS
# ══════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (havij|nikto|sqlmap|nmap|nessus|masscan|acunetix|burpsuite|w3af) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ══════════════════════════════════════════
# 5. GIỚI HẠN REQUEST SIZE
# ══════════════════════════════════════════
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value max_input_time 60
</IfModule>